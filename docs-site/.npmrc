# @altalyst/hookify is installed as a devDependency purely so the demo
# source files under src/hook-examples/** get real type-checking / editor
# support while authoring docs. Its peer deps require react/react-dom ^18,
# while this Docusaurus site itself runs on React 19 — that mismatch has no
# runtime impact (the example files never execute inside the Docusaurus app;
# they only run inside the Sandpack iframe, which resolves its own React 18
# from npm). legacy-peer-deps avoids a spurious ERESOLVE for this one case.
legacy-peer-deps=true
