{
  "name": "@altalyst/hookify",
  "version": "0.13.0",
  "description": "A lightweight, dependency-free collection of framework-agnostic React hooks for debouncing, data fetching, toggling state, syncing state to storage, detecting outside clicks, and more.",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "typescript",
    "state-management",
    "data-fetching",
    "debounce",
    "local-storage",
    "toggle",
    "outside-click",
    "frontend",
    "utility-hooks"
  ],
  "homepage": "https://altalyst-solutions.github.io/hookify",
  "bugs": {
    "url": "https://github.com/altalyst-solutions/hookify/issues"
  },
  "author": "Altalyst Solutions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/altalyst-solutions/hookify.git",
    "directory": "packages/hookify"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/hookify.cjs",
  "module": "./dist/hookify.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/hookify.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/hookify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "pnpm typecheck && vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^24.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.5.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.5"
  }
}
