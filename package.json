{
  "name": "hookify-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "watch": "pnpm -F @altalyst/hookify watch",
    "typecheck": "pnpm -F @altalyst/hookify typecheck",
    "typecheck:all": "pnpm build && pnpm -F @altalyst/hookify-mcp typecheck && pnpm -F docs-site typecheck && node e2e/consumers/run.mjs --script=typecheck",
    "test": "pnpm -F @altalyst/hookify test",
    "coverage": "pnpm -F @altalyst/hookify coverage",
    "test:mcp": "pnpm -F @altalyst/hookify-mcp test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm -F docs-site start",
    "docs:dev:local": "pnpm -F @altalyst/hookify build && pnpm docs:sizes && HOOKIFY_LOCAL=1 pnpm -F docs-site start",
    "docs:sizes": "node .github/scripts/generate-hook-sizes.mjs",
    "docs:build": "pnpm -F @altalyst/hookify build && pnpm docs:sizes && pnpm -F docs-site build",
    "docs:serve": "pnpm -F docs-site serve",
    "docs:check": "node .github/scripts/check-hook-frontmatter.mjs && node .github/scripts/check-docs-syntax.mjs",
    "changeset": "changeset",
    "changeset:check": "node .github/scripts/check-changesets.mjs",
    "dist:check": "node .github/scripts/check-dist.mjs",
    "check:package": "node .github/scripts/check-package.mjs",
    "size": "size-limit",
    "size:update": "node .github/scripts/update-size-budgets.mjs",
    "test:consumers": "node e2e/consumers/run.mjs",
    "setup:consumers": "node e2e/consumers/run.mjs --install",
    "version": "changeset version && node .github/scripts/sync-server-json.mjs && pnpm install --lockfile-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.9.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^15.9.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "yaml": "^2.9.1"
  }
}
