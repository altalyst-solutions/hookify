{
  "name": "@altalyst/hookify",
  "version": "0.8.0",
  "description": "A lightweight, dependency-free collection of framework-agnostic React hooks for debouncing, data fetching, toggling state, syncing state to storage, detecting outside clicks, and more.",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "typescript",
    "state-management",
    "data-fetching",
    "debounce",
    "local-storage",
    "toggle",
    "outside-click",
    "frontend",
    "utility-hooks"
  ],
  "homepage": "https://altalyst-solutions.github.io/hookify",
  "bugs": {
    "url": "https://github.com/altalyst-solutions/hookify/issues"
  },
  "author": "Altalyst Solutions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/altalyst-solutions/hookify.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/hookify.cjs",
  "module": "./dist/hookify.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/hookify.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/hookify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "setup": "npm install",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "docs:install": "cd docs-site && npm install",
    "docs:dev": "cd docs-site && npm start",
    "docs:dev:local": "npm run build && cd docs-site && HOOKIFY_LOCAL=1 npm start",
    "docs:build": "cd docs-site && npm run build",
    "docs:serve": "cd docs-site && npm run serve",
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.9.0",
    "@microsoft/api-extractor": "^7.59.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "prettier": "^3.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
