{
  "name": "hookify-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "pnpm -F @altalyst/hookify build",
    "watch": "pnpm -F @altalyst/hookify watch",
    "typecheck": "pnpm -F @altalyst/hookify typecheck",
    "test": "pnpm -F @altalyst/hookify test",
    "coverage": "pnpm -F @altalyst/hookify coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm -F docs-site start",
    "docs:dev:local": "pnpm build && HOOKIFY_LOCAL=1 pnpm -F docs-site start",
    "docs:build": "pnpm -F docs-site build",
    "docs:serve": "pnpm -F docs-site serve",
    "docs:check": "node .github/scripts/check-hook-frontmatter.mjs",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^15.9.0",
    "prettier": "^3.4.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "yaml": "^2.9.1"
  }
}
